rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Healthcheck collection for checking connection status
    match /_healthcheck/{docId} {
      allow read, write: if true;
    }

    // Notes collection
    match /notes/{noteId} {
      // Anyone can read your notes across devices
      allow read: if true;
      // Allow writes (Create, Update, Delete)
      // Tip: You can also restrict writes with Firebase Authentication if preferred
      allow write: if true;
    }

    // Folders / Branches collection
    match /folders/{folderId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
